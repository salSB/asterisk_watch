{{define "header"}}
<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="utf-8">
        <meta http-equiv="X-UA-Compatible" content="IE=edge">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <!-- The above 3 meta tags *must* come first in the head; any other head content must come *after* these tags -->
        <title>SimplyBits</title>

        <!-- Bootstrap -->
        <link rel="stylesheet" href="/static/bootstrap/3.3.6/css/bootstrap.min.css">
        {{template "pageCSS"}}
    </head>
    <body>
        <!-- jQuery (necessary for Bootstrap's JavaScript plugins) -->
        <script src="/static/js/jquery/1.12.3/jquery.min.js"></script>
        <!-- Include all compiled plugins (below), or include individual files as needed -->
        <script src="/static/bootstrap/3.3.6/bootstrap.min.js"></script>
        <script src="/static/js/jquery.animate-colors-min.js"></script>
        <script src="/static/js/xdate.js"></script>
        <nav class="navbar navbar-default navbar-inverse">
            <div class="container-fluid">
                <!-- Brand and toggle get grouped for better mobile display -->
                <div class="navbar-header">
                    <button type="button" class="navbar-toggle collapsed" data-toggle="collapse" data-target="#navbar-collapse-1" aria-expanded="false">
                        <span class="sr-only">Toggle navigation</span>
                        <span class="icon-bar"></span>
                        <span class="icon-bar"></span>
                        <span class="icon-bar"></span>
                    </button>
                    <a class="navbar-brand" href="https://uc.simplybits.net">SimplyBits&trade;</a>
                </div>
                <div class="collapse navbar-collapse" id="navbar-collapse-1">
                    <ul class="nav navbar-nav">
                        {{template "extraNav" .}}
                    </ul>
                    <ul class="nav navbar-nav">
                        {{template "extraRightNav" .}}
                    </ul>
                    <ul class="nav navbar-nav navbar-right">
                        <li><a href="https://uc.simplybits.net/logout">Log Out</a></li>
                    </ul>
                </div>
            </div>
        </nav>
{{end}}
