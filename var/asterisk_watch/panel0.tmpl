{{define "pageCSS"}}
<style>
html {
  overflow-y: scroll;
}
.exten {
    font-size: 140%;
    margin: 0 3px 0 3px;
    text-align: center;
}
.statusText {
    font-size: 100%;
    margin: 0 3px 0 3px;
    text-align: center;
}
.statusTextCID {
    font-size: 100%;
    margin: 0 3px 0 3px;
    text-align: center;
}
.smallText {
    font-size: 60%;
}
.statusTimer {
    font-size: 100%;
    margin: 0 3px 0 3px;
    text-align: center;
}
.status-0 { /* idle */
    background: #3cd832;
    font-weight: 400;
}
.status-1 {   /* busy */
    background: #f78484;
}
.status-2 {   /* inuse */
    background: blue;
    color: white;
}
.status-4 { /* unavailable */
    background: #CCC;
}
.status-8 {  /* ringing */
    background: yellow;
}
.status-9 { /* inuse&ringing */
    background: yellow;
}
.status-16 {  /* onhold */
    background: #e2fb12;
}
.status-17 { /* inuse&hold */
    background: blue;
    color: white;
}
.hintLabel {
    overflow: hidden;
    white-space: nowrap;
    margin: 0 3px 0 3px;
    text-align: center;
}
.grid-hint {
    width:100%;
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: stretch;
}
.grid-item-hint {
    flex-grow: 1;
    flex-shrink: 0;
    flex-basis: 100px;
    font-size: 100%;
    border: 1px solid black;
    margin-bottom: 2px;
    margin-right: 2px;
}

.parkinglot {
    background-color: #131556;
    font-size: 120%;
    text-align: center;
    color: white;
}

.grid-parking{
    width:100%;
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    align-content: flex-start;
    align-items: stretch;
}

.grid-item-parking {
    flex-basis: 480px;
    flex-grow: 0;
    flex-shrink: 1;
    border: 1px solid black;
    margin-bottom: 2px;
    margin-right: 2px;
}


.grid-queue {
    width:100%;
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    align-content: flex-start;
    align-items: stretch;
}
.grid-item-queue {
    flex-basis: 330px;
    flex-grow: 1;
    flex-shrink: 0;
    border: 1px solid black;
    margin-bottom: 2px;
    margin-right: 2px;
}
.queuename {
    background-color: #131556;
    font-size: 120%;
    text-align: center;
    color: white;
}
.queuestatlabel {
    font-size: 110%;
    text-align: left;
    padding-left: 3px;
    padding-right: 3px;
    padding-bottom: 1px;
}
.queuestatvalue {
    float:right;
    font-weight: bold;
    text-align:right;
}
.noagents {
}
.callcount {
}
.callsTaken {
    float: right;
    margin-right: 0.2em;
}
.callsTaken:hover:before
{
    position: absolute;
    right: 3em;
    color:white;
    box-shadow: 6px 6px 10px #888;
    background-color: #131556;
    font-size: 80%;
    font-style: italic;
    content: " Calls taken\2192";
}
.agentName {
}
.agentIcon {
}
.agentUnavail {
    background-color: gray;
}
.agentBusy {
    background-color: blue;
}
.agentIdle {
    background-color: green;
}
.agentRing {
    background-color: yellow;
}
.agentPaused {
    background-color: red;
}
.agentPenalty:hover:after
{
    position: absolute;
    color:white;
    box-shadow: 6px 6px 10px #888;
    background-color: #131556;
    font-size: 80%;
    font-style: italic;
    content: "\2190Penalty";
}
.callerPosition {
    background: rgba(0,0,0,0.82);
    margin-left: 1px;
    margin-right: 2em;
}
.callerID {
    padding-right: 2em;
}
.callerWhenEntered {

}
.isoffline {
    display: none;
}
</style>
{{end}}
{{define "extraNav"}}
    {{if gt (len .Vars) 0}}
        <li><a id="varsMenu" href="#">PBX Controls</a></li>
    {{end}}
    {{if eq .PanelAccess 2}}
    <li><a href="/edit/{{.PanelID}}">Edit Layout</a></li>
    {{end}}
{{end}}
{{template "header" .}}
<div class="container-fluid">
    <div class="row isoffline">
        <div class="col-md-12">
            <div class="panel panel-warning">
                <div class="panel-heading">
                    <h3 class="panel-title">Offline</h3>
                </div>
                <div class="panel-body">
                    Communications with server lost, will retry <span id="retryCountdown">5</span> seconds
                </div>
            </div>
        </div>
    </div>
    <div id="grid-vars" class="row" style="display:none;">
    {{range .Vars}}
        <div class="col-sm-4 col-md-3 col-lg-3">
            <label>{{.Label}}</label>
        {{if eq .Type "Toggle"}}
            {{$name := .Name}}
            {{$values := .Values}}
            {{range $index, $element := .Options}}
            <div class="radio">
                <label>
                    <input type="radio" name="VAR_{{$name}}" value="{{index $values $index}}"> {{$element}}
                </label>
            </div>
            {{end}}
        {{else if eq .Type "List"}}
            {{$name := .Name}}
            {{$values := .Values}}
            {{range $index, $element := .Options}}
            <div class="radio">
                <label>
                    <input type="radio" name="VAR_{{$name}}" value="{{index $values $index}}"> {{$element}}
                </label>
            </div>
            {{end}}
        {{end}}
            <p var="VAR_{{.Name}}" style="display:none;" class="text-success">Changed</p>
        </div>
    {{end}}
    </div>
    <div class="grid-hint">
        {{range .Exts}}
        <div class="grid-item-hint status-{{.Status}}" data-status={{.Status}} data-exten="{{.Exten}}">
            <p class="exten">{{.Exten}}</p>
            <p class="hintLabel">{{.Label}}</p>
            {{if eq .ShowCID 1}}<p class="statusTextCID">{{.StatusStr}}</p>
            {{else}}<p class="statusText">{{.StatusStr}}</p>{{end}}
            <p class="statusTimer" data-time="{{.LastStatusChange}}">&nbsp;</p>
        </div>
        {{end}}
    </div>
    {{if gt (len .ParkedCalls) 0}}
    <div class="grid-parking">
        <div class="grid-item-parking" data-park="parked_calls">
            <div class="row">
                <div class="col-xs-12"><div class="parkinglot">Parked Calls</div></div>
            </div>
            <div class="row col-xs-12" style="margin:0 auto">
                {{range .ParkedCalls}}
                <div class="col">
                    <span>Lot {{.ParkingSpace}} - Ext {{.ParkeeExten}} 🚗 {{.ParkeeCallerIDName}} ({{.ParkeeCallerIDNum}}) &nbsp;&nbsp;&nbsp;&nbsp;⏲ <span data-id="{{.ParkeeChannel}}" data-time="{{.ParkedAt}}" data-duration="{{.ParkingDuration}}" data-timeout="{{.ParkingTimeout}}">{{.ParkingDuration}}</span></span>
                </div>
                {{end}}
            </div>
        </div>
    </div>
    {{end}}
</div>
<script>
function addAgent(a) {
}

function emptyCallers(queuename) {
}

function addCaller(queuename, c) {
}
</script>
{{template "appcode" .}}
{{template "footer"}}
